{
  "schema": "hasna.service_contract.v1",
  "name": "telephony",
  "class": "cli-with-store",
  "contractVersion": "v1",
  "kitVersion": "0.8.1",
  "description": "Telephony platform for AI agents with SMS, WhatsApp, voice calls, TTS/STT, and real-time streaming. Local mode uses SQLite at ~/.hasna/telephony/telephony.db; cloud mode (HASNA_TELEPHONY_STORAGE_MODE=cloud) is PURE REMOTE per Amendment A1 — the serve process reads and writes PostgreSQL directly.",
  "bins": [
    "telephony",
    "telephony-mcp",
    "telephony-serve"
  ],
  "deploymentModes": [
    "local",
    "self_hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "http",
      "kind": "api",
      "status": "supported",
      "bin": "telephony-serve",
      "authMode": "api-key",
      "deploymentModes": [
        "local",
        "self_hosted"
      ],
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": false
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "telephony-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "deploymentModes": [
        "local",
        "self_hosted"
      ],
      "exportSubpath": ".",
      "generatedFrom": "/openapi.json",
      "clientClassName": "TelephonyApiClient"
    },
    {
      "name": "telephony-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "telephony",
      "authMode": "local-only",
      "deploymentModes": [
        "local",
        "self_hosted"
      ]
    },
    {
      "name": "telephony-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "telephony-mcp",
      "authMode": "local-only",
      "deploymentModes": [
        "local",
        "self_hosted"
      ]
    }
  ],
  "storage": {
    "mode": "local",
    "engines": [
      "sqlite",
      "postgres"
    ],
    "envPrefix": "HASNA_TELEPHONY_",
    "aliasEnvPrefix": "TELEPHONY_",
    "sqlitePath": "~/.hasna/telephony/telephony.db",
    "pgTestGate": {
      "envVar": "HASNA_TELEPHONY_TEST_DATABASE_URL",
      "command": "bun run test:pg"
    }
  },
  "hosting": [
    "user-hosted"
  ],
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "scan-artifact"
      }
    }
  }
}
