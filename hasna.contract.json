{
  "schema": "hasna.service_contract.v1",
  "name": "telephony",
  "class": "cli-with-store",
  "contractVersion": "v1",
  "kitVersion": "0.8.0",
  "description": "Telephony platform for AI agents with SMS, WhatsApp, voice calls, TTS/STT, real-time streaming, and a local SQLite store.",
  "bins": [
    "telephony",
    "telephony-mcp",
    "telephony-serve"
  ],
  "deploymentModes": [
    "local",
    "self_hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "http",
      "kind": "api",
      "status": "supported",
      "bin": "telephony-serve",
      "authMode": "api-key",
      "deploymentModes": [
        "local",
        "self_hosted"
      ],
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": false
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "telephony-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "deploymentModes": [
        "local",
        "self_hosted"
      ],
      "exportSubpath": ".",
      "generatedFrom": "/openapi.json",
      "clientClassName": "TelephonyApiClient"
    },
    {
      "name": "telephony-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "telephony",
      "authMode": "local-only",
      "deploymentModes": [
        "local",
        "self_hosted"
      ]
    },
    {
      "name": "telephony-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "telephony-mcp",
      "authMode": "local-only",
      "deploymentModes": [
        "local",
        "self_hosted"
      ]
    }
  ],
  "storage": {
    "mode": "local",
    "engines": [
      "sqlite"
    ],
    "envPrefix": "HASNA_TELEPHONY_",
    "aliasEnvPrefix": "TELEPHONY_",
    "sqlitePath": "~/.hasna/telephony/telephony.db"
  },
  "hosting": [
    "user-hosted"
  ],
  "metadata": {
    "conformance": {
      "waivedStorageEngines": [
        {
          "engine": "postgres",
          "reason": "Telephony owns a single-operator local SQLite state store; PostgreSQL adoption is tracked through the vendored @hasna/contracts storage kit.",
          "reviewedBy": "platform-storage",
          "expiresAt": "2027-01-01T00:00:00.000Z"
        }
      ]
    }
  }
}
